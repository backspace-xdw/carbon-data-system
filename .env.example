# 服务端基础配置
NODE_ENV=development
PORT=7090
HOST=0.0.0.0

# 登录 Token 签名密钥（部署到生产请务必修改）
JWT_SECRET=carbon-please-change-in-production
JWT_TTL=7d

# 数据库（SQLite，文件位置）
DATABASE_URL=file:./dev.db

# 时序库 InfluxDB
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=carbon-token-2026
INFLUX_ORG=carbon-rt
INFLUX_BUCKET_REALTIME=energy_stream
INFLUX_BUCKET_AGG=energy_agg

# MQTT 消息中间件
MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=carbon/meter

# 日志级别
LOG_LEVEL=info
